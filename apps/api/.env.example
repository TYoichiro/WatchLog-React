# apps/api/.env にコピーして使う（.env は git 管理外）

# ローカル開発用。docker compose up -d db で起動する PostgreSQL に接続する
DATABASE_URL="postgresql://watchlog:watchlog@localhost:5432/watchlog?schema=public"

# ローカル開発では API を 3001 番で起動し、Vite（3000 番）が /api を転送する。
# Docker では compose が 3000 番に上書きする
PORT=3001

# ---- 認証（Auth.js / Google OAuth）----
# ブラウザで開く URL（開発でも Docker でも http://localhost:3000）に /api/auth を付けたもの。
# Google OAuth のリダイレクト URI は {AUTH_URL}/callback/google（= http://localhost:3000/api/auth/callback/google）
AUTH_URL="http://localhost:3000/api/auth"
# 署名用の秘密鍵。生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Google Cloud Console で発行した OAuth クライアントの ID とシークレット
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

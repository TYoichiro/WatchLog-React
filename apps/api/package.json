    "prisma:seed": "prisma db seed",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@hono/auth-js": "^1.1.1",
    "@hono/node-server": "^2.1.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@watchlog/shared": "*",
    "dotenv": "^18.0.5",
    "fflate": "^0.8.3",
    "hono": "^4.13.12",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
